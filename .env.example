# ═══════════════════════════════════════════════════════════════════════════
# AI Gym Coach Pro — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
#
# Copy this file to `.env` and fill in the values.
# For Vercel deployment, add these as Environment Variables in the Vercel
# dashboard (Settings → Environment Variables).
#
# The app works in DEMO MODE with just DATABASE_URL + NEXTAUTH_URL + NEXTAUTH_SECRET.
# All other vars are optional add-ons — the app gracefully falls back when
# they're missing.

# ─── REQUIRED (core app) ────────────────────────────────────────────────────

# Database — SQLite for local dev; PostgreSQL for production.
# For Vercel: use Neon (https://neon.tech), Supabase, or Vercel Postgres.
# Example: postgresql://user:pass@host:5432/db?sslmode=require
#
# For SQLite, keep the path RELATIVE — Prisma resolves it against
# prisma/schema.prisma, so this works on every machine and OS. An absolute
# POSIX path here silently breaks auth on Windows.
DATABASE_URL="file:../db/custom.db"

# NextAuth — REQUIRED for auth to work.
# Generate a secret with: openssl rand -base64 32
# For Vercel: set NEXTAUTH_URL to your production URL (https://your-app.vercel.app)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# Public origin, used as the absolute base for OG/Twitter preview images.
# Leave blank on Vercel previews (NEXT_PUBLIC_VERCEL_URL is used instead);
# set it explicitly in production so social cards point at your own domain.
NEXT_PUBLIC_SITE_URL=

# ─── OPTIONAL: Supabase (Database + Auth + Google OAuth) ────────────────────
# Get from: https://supabase.com → Project Settings → API
# When configured, the app can use Supabase for: database, auth, or both.
# If you set DATABASE_URL to the Supabase Postgres connection string, the
# app uses Supabase as its database (via Prisma).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # server-only, bypasses RLS — keep secret!
NEXT_PUBLIC_SUPABASE_GOOGLE_ENABLED=false  # set true to use Supabase Google OAuth

# ─── OPTIONAL: Google OAuth (via NextAuth) ──────────────────────────────────
# Alternative to Supabase Google OAuth. Use ONE or the other (not both).
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The two above are server-only, so the browser cannot see them. Set this
# public mirror to `true` as well, otherwise the "Continue with Google" button
# never renders on the client.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# ─── OPTIONAL: Razorpay (India-focused payments — UPI, cards, netbanking) ───
# Get from: https://dashboard.razorpay.com/app/keys
# Takes precedence over Stripe when both are configured.
# Create plans in the Razorpay dashboard, then paste the plan IDs below.
RAZORPAY_KEY_ID=                     # rzp_test_xxx or rzp_live_xxx
RAZORPAY_KEY_SECRET=                 # secret key — keep server-side only!
RAZORPAY_WEBHOOK_SECRET=             # from webhook settings
RAZORPAY_PLAN_PRO_MONTHLY=           # plan_xxx (₹999/mo)
RAZORPAY_PLAN_PRO_ANNUAL=            # plan_xxx (₹9,599/yr — save 20%)
RAZORPAY_PLAN_TRAINER_MONTHLY=       # plan_xxx (₹2,900/mo)
RAZORPAY_PLAN_TRAINER_ANNUAL=        # plan_xxx (₹27,840/yr — save 20%)
NEXT_PUBLIC_RAZORPAY_KEY_ID=         # same as RAZORPAY_KEY_ID (safe to expose)
NEXT_PUBLIC_RAZORPAY_ENABLED=false   # set true to surface Razorpay UI

# ─── OPTIONAL: Stripe (International payments) ──────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
# Used as fallback when Razorpay isn't configured.
STRIPE_SECRET_KEY=                   # sk_test_... or sk_live_...
STRIPE_WEBHOOK_SECRET=               # whsec_...
STRIPE_PRICE_PRO_MONTHLY=            # price_... ($9.99/mo)
STRIPE_PRICE_PRO_ANNUAL=             # price_... ($95.90/yr)
STRIPE_PRICE_TRAINER_MONTHLY=        # price_... ($29/mo)
STRIPE_PRICE_TRAINER_ANNUAL=         # price_... ($278.40/yr)
NEXT_PUBLIC_STRIPE_ENABLED=false     # set true to surface Stripe UI

# ─── OPTIONAL: Resend (Transactional email) ─────────────────────────────────
# Get from: https://resend.com → API Keys
# When configured, sends: welcome email, weekly summary, password reset.
# When NOT configured, email functions are silent no-ops.
RESEND_API_KEY=                      # re_xxx — server-side only
NEXT_PUBLIC_RESEND_FROM="AI Gym Coach Pro <noreply@yourdomain.com>"

# ─── OPTIONAL: Sentry (Error monitoring) ────────────────────────────────────
# Get from: https://sentry.io → Settings → Client Keys
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ─── OPTIONAL: PostHog (Product analytics) ──────────────────────────────────
# Get from: https://posthog.com → Project Settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Vercel-specific notes ──────────────────────────────────────────────────
# Vercel automatically sets NEXT_PUBLIC_VERCEL_URL for previews.
# For production, explicitly set NEXTAUTH_URL=https://yourdomain.com.
# Vercel handles the build via `npm run build` (see vercel.json).
# The Prisma client is generated during build (postinstall hook).
#
# IMPORTANT: SQLite does NOT work on Vercel — the filesystem is read-only and
# per-invocation, so writes vanish and every instance sees a different DB.
# Point DATABASE_URL at hosted Postgres (Neon/Supabase/Vercel Postgres) and
# switch `provider` in prisma/schema.prisma to "postgresql" before deploying.
#
# FALLBACK BEHAVIOR (when services are missing):
#   - No Supabase → uses Prisma + SQLite/Postgres + NextAuth credentials
#   - No Google OAuth → email/password + demo login only
#   - No Razorpay + No Stripe → pricing buttons show "Coming Soon"
#   - No Resend → no emails sent (welcome/weekly/reset are silent no-ops)
#   - No Sentry → errors logged to console only
#   - No PostHog → no analytics tracking
#   - Demo mode ALWAYS works (uses local DB + NextAuth credentials)
