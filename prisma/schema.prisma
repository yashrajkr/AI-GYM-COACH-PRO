// AI Gym Coach Pro — Production Schema
// Supports: users, profiles, workouts, goals, measurements, achievements, notifications, referrals, activity logs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  passwordHash      String?
  image             String?
  tier              String    @default("free") // free | pro | trainer | enterprise
  totalXp           Int       @default(0)
  streak            Int       @default(0)
  longestStreak     Int       @default(0)
  stripeCustomerId  String?   @unique
  stripeSubId       String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  profile           Profile?
  workouts          Workout[]
  accounts          Account[]
  sessions          Session[]
  goals             Goal[]
  measurements      Measurement[]
  achievements      Achievement[]
  userAchievements  UserAchievement[]
  notifications     Notification[]
  referralsMade     Referral[]     @relation("Referrer")
  referralsReceived Referral[]     @relation("Referee")
  activityLogs      ActivityLog[]
  settings          UserSettings?
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  bio             String?
  dateOfBirth     DateTime?
  gender          String?  // male | female | other
  heightCm        Float?
  weightKg        Float?
  fitnessLevel    String   @default("beginner") // beginner | intermediate | advanced | elite
  primaryGoal     String?  // strength | hypertrophy | weight_loss | conditioning | mobility
  equipment       String   @default("bodyweight") // bodyweight | dumbbell | barbell | kettlebell | band | machine
  daysPerWeek     Int      @default(3)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  coachEnabled    Boolean  @default(true)
  coachPersonality String  @default("drill") // drill | zen | technical
  soundEnabled    Boolean  @default(true)
  notifications   Boolean  @default(true)
  units           String   @default("metric") // metric | imperial
  theme           String   @default("dark") // dark | light | system
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// WORKOUTS & EXERCISES
// ============================================================

model Workout {
  id              String   @id @default(cuid())
  userId          String
  exerciseId      String
  exerciseName    String
  totalReps       Int
  setsCompleted   Int
  durationSec     Int
  avgFormScore    Int
  bestFormScore   Int
  loadKg          Float?   // weight used (if any)
  estimated1RM    Float?   // estimated 1-rep max
  caloriesBurned  Int?     // estimated calories
  intensityScore  Int?     // 0-100 workout intensity
  date            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([exerciseId, date])
}

model Goal {
  id          String   @id @default(cuid())
  userId      String
  type        String   // workout_frequency | volume | pr | weight | streak
  target      Float
  current     Float    @default(0)
  period      String   @default("weekly") // daily | weekly | monthly | lifetime
  status      String   @default("active") // active | completed | abandoned
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Measurement {
  id          String   @id @default(cuid())
  userId      String
  type        String   // weight | body_fat | chest | waist | hips | arm | thigh | calf
  value       Float
  unit        String   @default("kg") // kg | lbs | cm | in | %
  date        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, date])
}

// ============================================================
// GAMIFICATION & SOCIAL
// ============================================================

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  type        String   // streak | volume | pr | form | social | special
  name        String
  description String
  icon        String
  earnedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, name])
}

model UserAchievement {
  id          String   @id @default(cuid())
  userId      String
  achievementId String
  earnedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // streak_warning | weekly_summary | achievement | referral | system
  title     String
  body      String
  read      Boolean  @default(false)
  data      String?  // JSON string for extra context
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model Referral {
  id          String   @id @default(cuid())
  referrerId  String
  refereeId   String
  code        String   @unique
  reward      String   @default("xp_300") // xp_300 | pro_month | etc
  status      String   @default("pending") // pending | completed | rewarded
  createdAt   DateTime @default(now())
  completedAt DateTime?

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([refereeId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String   // workout_completed | achievement_earned | goal_completed | profile_updated | subscription_changed
  entityType  String   // workout | achievement | goal | profile | subscription
  entityId    String?
  metadata    String?  // JSON string
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}
